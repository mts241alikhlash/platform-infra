{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://241.example.invalid/schemas/routing-manifest-v1.json",
  "title": "241 web routing manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app", "webVersion", "servicePrefixes", "unroutedPrefixes", "healthRoutes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "enum": ["academic", "admin", "admission", "assessment", "hr", "inventory", "portal"] },
    "webVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "servicePrefixes": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/prefix" }, "uniqueItems": true }
    },
    "unroutedPrefixes": { "type": "array", "items": { "$ref": "#/$defs/prefix" }, "uniqueItems": true },
    "healthRoutes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "service"],
        "properties": {
          "path": { "$ref": "#/$defs/prefix" },
          "service": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "prefix": { "type": "string", "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" }
  }
}
