{
  "schemaVersion": 1,
  "app": "inventory",
  "webVersion": "1.4.1",
  "servicePrefixes": {
    "identity": [
      "/auth",
      "/sso",
      "/profiles",
      "/school-unit-types",
      "/religions",
      "/blood-types",
      "/regions"
    ],
    "inventory": [
      "/inventory"
    ]
  },
  "unroutedPrefixes": [
    "/dashboard",
    "/settings"
  ],
  "healthRoutes": [
    {
      "path": "/health/identity",
      "service": "identity"
    },
    {
      "path": "/health/inventory",
      "service": "inventory"
    }
  ]
}
