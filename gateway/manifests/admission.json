{
  "schemaVersion": 1,
  "app": "admission",
  "webVersion": "0.1.1",
  "servicePrefixes": {
    "identity": [
      "/auth",
      "/users",
      "/profiles",
      "/religions",
      "/blood-types"
    ],
    "academic": [
      "/academic-years"
    ],
    "admission": [
      "/admissions"
    ]
  },
  "unroutedPrefixes": [
    "/settings"
  ],
  "healthRoutes": [
    {
      "path": "/health/identity",
      "service": "identity"
    },
    {
      "path": "/health/academic",
      "service": "academic"
    },
    {
      "path": "/health/admission",
      "service": "admission"
    }
  ]
}
