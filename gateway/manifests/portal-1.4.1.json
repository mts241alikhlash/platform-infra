{
  "schemaVersion": 1,
  "app": "portal",
  "webVersion": "1.4.1",
  "servicePrefixes": {
    "identity": [
      "/auth",
      "/sso",
      "/users",
      "/profiles",
      "/school-units",
      "/school-unit-types",
      "/religions",
      "/blood-types",
      "/regions"
    ],
    "portal": [
      "/portal",
      "/files"
    ]
  },
  "unroutedPrefixes": [
    "/settings"
  ],
  "healthRoutes": [
    {
      "path": "/health/identity",
      "service": "identity"
    },
    {
      "path": "/health/portal",
      "service": "portal"
    }
  ]
}
